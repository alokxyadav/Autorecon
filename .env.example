# Copy this file to .env and fill in real values. Never commit the real .env file.

# Defaults to local SQLite if unset — fine for dev/demo.
# For Postgres: postgresql+psycopg2://user:password@host:5432/autorecon
DATABASE_URL=sqlite:///./autorecon.db

# Required starting in Phase 2 (Claude reasoning layer). Not used in Phase 1.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 2 policy gate tuning (optional — sensible defaults are in code)
AUTO_APPROVE_CONFIDENCE_THRESHOLD=90
AUTO_APPROVE_MAX_AMOUNT=500.00

# Phase 7: set this to require an API key on all data endpoints (/health is
# always open). Leave blank to disable auth for local dev.
AUTORECON_API_KEY=

# Postgres connection pool tuning (ignored for SQLite). Defaults are sane
# for a single small instance — raise for higher-traffic deployments.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Comma-separated list of allowed frontend origins for CORS. Leave as "*"
# for local dev; set to your real deployed frontend URL(s) in production.
CORS_ALLOWED_ORIGINS=*
